FROM php:8.4-fpm
ARG BUILD_DATE
LABEL org.opencontainers.image.authors="sinfallas@gmail.com"
LABEL org.opencontainers.image.created=$BUILD_DATE

RUN mkdir -p /var/www/
WORKDIR /var/www

RUN apt-get update -qq && apt-get -y dist-upgrade && apt-get -y --no-install-recommends --no-install-suggests install zip unzip wget nano curl git && apt-get clean && apt-get -y autoremove && rm -rf /var/lib/apt/lists/* && rm -rf /var/lib/{dpkg,cache,log}

COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions bcmath mbstring pcntl intl zip opcache gd pdo pdo_pgsql pgsql

COPY ./php.ini /usr/local/etc/php/php.ini
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN chmod 777 /usr/bin/composer
RUN groupadd -g 1000 www && useradd -u 1000 -ms /bin/bash -g www www

CMD ["php-fpm"]
